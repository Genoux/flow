post_install() {
	udevadm control --reload-rules
	udevadm trigger
	cat <<-'EOF'
	Flow types by opening /dev/uinput. If your user isn't already in the
	'input' group (or otherwise granted a uinput ACL), run:

	  sudo usermod -aG input "$USER"

	then log out and back in. Start the daemon with:

	  systemctl --user enable --now flow.service
	EOF
}

post_upgrade() {
	post_install
}
