[Unit]
Description=Flow voice dictation
# Wayland clipboard and the uinput uaccess ACL both require the graphical
# session, so the daemon must not outlive it.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# No flags: behaviour belongs in ~/.config/flow/config.toml, which the daemon
# reads at startup and which works just as well absent. Flags here would win
# over that file and quietly make it look ignored.
ExecStart=%h/.local/bin/flow daemon
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
