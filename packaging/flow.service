[Unit]
Description=Flow voice dictation
# Wayland clipboard and the uinput uaccess ACL both require the graphical
# session, so the daemon must not outlive it.
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# --no-ptt: the Hyprland bind is the only trigger while A/B testing against
# another dictation tool, so Right Ctrl stays inert.
# --duck 50: halve other apps while recording. Relative to each stream, so a
# quiet one is not raised. Low enough to keep speakers out of the microphone,
# high enough that music stays audible rather than sounding muted.
ExecStart=%h/Desktop/@john/flow/target/release/flow daemon --no-ptt --duck 50
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
