#!/bin/sh
# Managed by jb-toolkit (jb sync). RULES.md R4.2.
# Prints the project version (the top-level one: never a nested or dependency version). Fails when no manifest names one or two disagree.
#   .toolkit/version          print the version
#   .toolkit/version --files  print "<file> <version>" for every manifest read
# Extra manifests (e.g. workspace members) go one path per line in
# .toolkit/version-files, which the project owns.
cd "$(dirname "$0")/.." || exit 1

read_version() {
  case "$1" in
    *Cargo.toml)
      toml_version "$1" "[package] [workspace.package]" ;;
    *pyproject.toml)
      toml_version "$1" "[project]" ;;
    *package.json)
      jq -r '.version // empty | strings' "$1" ;;
    *VERSION)
      tr -d '[:space:]' < "$1" ;;
  esac
}

# The version key of one table only: a dependency's version is not ours.
# `version.workspace = true` has no literal and is skipped.
toml_version() {
  awk -v tables="$2" '
    BEGIN { n = split(tables, wanted, " ") }
    /^\[/ {
      header = $0; sub(/[[:space:]]*(#.*)?$/, "", header); in_table = 0
      for (i = 1; i <= n; i++) if (header == wanted[i]) in_table = 1
      next
    }
    in_table && match($0, /^version[[:space:]]*=[[:space:]]*"[^"]*"/) {
      v = substr($0, RSTART, RLENGTH); sub(/^[^"]*"/, "", v); sub(/"$/, "", v); print v; exit
    }' "$1"
}

files=""
for f in Cargo.toml package.json pyproject.toml VERSION; do
  [ -f "$f" ] && files="$files $f"
done
if [ -f .toolkit/version-files ]; then
  files="$files $(grep -v '^[[:space:]]*#' .toolkit/version-files | tr '\n' ' ')"
fi

found=""
for f in $files; do
  [ -f "$f" ] || { echo "listed manifest $f does not exist" >&2; exit 1; }
  v=$(read_version "$f")
  [ -n "$v" ] || continue
  [ "${1-}" = "--files" ] && echo "$f $v"
  if [ -z "$found" ]; then
    found=$v
  elif [ "$v" != "$found" ]; then
    echo "versions disagree: $f is $v, another manifest is $found" >&2
    exit 1
  fi
done

[ -n "$found" ] || { echo "no version found (Cargo.toml, package.json, pyproject.toml or VERSION)" >&2; exit 1; }
[ "${1-}" = "--files" ] || echo "$found"
